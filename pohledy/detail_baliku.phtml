<p><em><?= htmlspecialchars($deck->popis) ?></em></p>
<p class="deck-detail-author">Author: <strong><?= htmlspecialchars($deck->getAutor()->username) ?></strong></p>

<?php if (!empty($tags)): ?>
    <div class="deck-tags">
        <?php foreach ($tags as $tag): ?>
            <span class="tag"><?= htmlspecialchars($tag['nazev']) ?></span>
        <?php endforeach; ?>
    </div>
<?php endif; ?>

<h2>Cards:</h2>

<div class="card-filter-buttons">
    <button class="filter-btn active" data-filter="all">All Rows</button>
    <button class="filter-btn" data-filter="close">Close</button>
    <button class="filter-btn" data-filter="ranged">Ranged</button>
    <button class="filter-btn" data-filter="siege">Siege</button>
</div>

<?php if (empty($cards)): ?>
    <div class="no-cards">Nothing :(</div>
<?php else: ?>
    <div class="cards-grid">
        <?php foreach ($cards as $card): ?>
            <?php
                //Zobrazuje spravne jmeno frakce tka jak je to ve hře
                $rowNorm = strtolower(trim($card['row'] ?? ''));
                $factionRaw     = $card['deck'] ?? '';
                $factionDisplay = (strtolower(trim($factionRaw)) === 'realms') ? 'Northern Realms' : htmlspecialchars(ucwords($factionRaw));
            ?>
            <div class="card-item" data-row="<?= htmlspecialchars($rowNorm) ?>">
                <span class="card-amount"><?= (int)$card['pocet'] ?>x</span>

                <h3 class="card-title"><?= htmlspecialchars($card['name']) ?></h3>

                <div class="card-img-wrapper">
                    <?php if (!empty($card['filename'])): ?>
                        <img src="../obrazky/<?= htmlspecialchars($card['deck'] . '_' . $card['filename']) ?>.jpg"
                             alt="<?= htmlspecialchars($card['name']) ?>">
                    <?php else: ?>
                        <div class="no-img">No Image</div>
                    <?php endif; ?>
                </div>

                <div class="card-stats">
                    <div class="stat-row">
                        <span>Faction:</span>
                        <strong><?= $factionDisplay ?></strong>
                    </div>
                    <div class="stat-row">
                        <span>Row:</span>
                        <strong><?= htmlspecialchars(ucfirst($rowNorm)) ?></strong>
                    </div>
                    <div class="stat-row">
                        <span>Strength:</span>
                        <strong class="gold-text"><?= htmlspecialchars($card['strength']) ?></strong>
                    </div>
                    <div class="stat-row" title="<?= htmlspecialchars($card['ability'] ?? 'None') ?>">
                        <span>Ability:</span>
                        <strong class="ability-text"><?= htmlspecialchars($card['ability'] ?? 'None') ?></strong>
                    </div>
                </div>
            </div>
        <?php endforeach; ?>
    </div>
<?php endif; ?>

<script>
    document.querySelector('.decks-title').textContent = "<?= htmlspecialchars($deck->nazev) ?>";

    const filterBtns = document.querySelectorAll('.filter-btn');
    const cardItems  = document.querySelectorAll('.card-item');

    filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            filterBtns.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            const filterValue = btn.getAttribute('data-filter');
            console.log('[filter debug] clicked filter:', filterValue);

            cardItems.forEach(card => {
                const row  = (card.dataset.row || '').trim();
                const show = filterValue === 'all' || row === filterValue;
                card.style.display = show ? 'flex' : 'none';
            });
        });
    });
</script>

