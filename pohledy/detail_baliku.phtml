<div id="cardModal" class="modal-overlay">
    <div class="modal-content">
        <span class="modal-close">&times;</span>
        <div id="modalCardTarget">
            </div>
    </div>
</div>

<script>
    document.querySelector('.decks-title').textContent = "<?= htmlspecialchars($deck->nazev) ?>";

    const filterBtns = document.querySelectorAll('.filter-btn');
    const cardItems  = document.querySelectorAll('.card-item');

    filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            filterBtns.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            const filterValue = btn.getAttribute('data-filter');
            console.log('[filter debug] clicked filter:', filterValue);

            cardItems.forEach(card => {
                const row  = (card.dataset.row || '').trim();
                const show = filterValue === 'all' || row === filterValue;
                card.style.display = show ? 'flex' : 'none';
            });
        });
    });
    const modal = document.getElementById('cardModal');
    const modalTarget = document.getElementById('modalCardTarget');
    const modalClose = document.querySelector('.modal-close');

    //kdyz se klikne na jakoukoliv kartu ta kse zobrazi modal s tou kartou 
    cardItems.forEach(card => {
        card.addEventListener('click', () => {
            const clonedCard = card.cloneNode(true);
            clonedCard.removeAttribute('style');
            modalTarget.innerHTML = '';
            modalTarget.appendChild(clonedCard);
            modal.classList.add('open');
        });
    });
    modalClose.addEventListener('click', () => {
        modal.classList.remove('open');
    });
    modal.addEventListener('click', (e) => {
        if (e.target === modal) {
            modal.classList.remove('open');
        }
    });
</script>

