<script>
    const cardItems  = document.querySelectorAll('.preview-card-wrapper');

    const modal = document.getElementById('cardModal');
    const modalTarget = document.getElementById('modalCardTarget');
    const modalClose = document.querySelector('.modal-close');

    //when any card is clicked, a modal with that card is displayed 
    cardItems.forEach(card => {
        card.addEventListener('click', () => {
            const clonedCard = card.cloneNode(true);
            clonedCard.removeAttribute('style');
            modalTarget.innerHTML = '';
            modalTarget.appendChild(clonedCard);
            modalTarget.firstElementChild.setAttribute("style", "height: 100%; width: fit-content")
            modal.classList.add('open');
        });
    });
    modalClose.addEventListener('click', () => {
        modal.classList.remove('open');
    });
    modal.addEventListener('click', (e) => {
        if (e.target === modal) {
            modal.classList.remove('open');
        }
    });
</script>