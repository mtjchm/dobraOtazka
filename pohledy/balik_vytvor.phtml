<h1 class="decks-title">Deck Creation</h1>

<div class="deck-builder-container">
    
    <div class="new-deck-panel">
        <h2>Workspace</h2>
        
        <div class="deck-save-form">
            <input type="text" id="deckNameInput" class="builder-form-input" placeholder="Deck Name..." required>
            <textarea id="deckDescInput" class="builder-form-textarea" placeholder="Deck Description..." rows="3"></textarea>
            <button id="saveDeckBtn" class="builder-save-btn">
                Save Deck to Database
            </button>
        </div>

        <div class="deck-builder-stats">
            <div class="stat-line">Total Cards: <strong id="totalCardsCounter" class="gold-text">0</strong></div>
            <div class="stat-line">Units: <strong id="unitCardsCounter" class="stat-unit-counter">0 / 22 min</strong></div>
            <div class="stat-line">Special & Weather: <strong id="specialWeatherCounter" class="gold-text">0 / 10 max</strong></div>
        </div>
        
        <h3>Leader</h3>
        <div class="new-deck-leader-slot" id="leaderSlotContainer">
            <div class="leader-empty-box">
                <span>Select a Leader</span>
            </div>
        </div>

        <h3>Deck Content</h3>
        <div class="workspace-cards-grid" id="currentDeckContainer">
            <div class="no-cards">Your workspace is empty. Select a faction and click cards on the right.</div>
        </div>
    </div>

    <div class="available-cards-panel">
        <div class="builder-controls-row">
            <div class="card-filter-buttons">
                <button class="filter-btn" data-faction="realms">Northern Realms</button>
                <button class="filter-btn" data-faction="nilfgaard">Nilfgaard</button>
                <button class="filter-btn" data-faction="monsters">Monsters</button>
                <button class="filter-btn" data-faction="scoiatael">Scoia'tael</button>
                <button class="filter-btn" data-faction="skellige">Skellige</button>
            </div>
            
            <div class="search-container">
                <input type="text" id="cardSearchInput" placeholder="Search cards by name or ability..." autocomplete="off">
            </div>
        </div>
        
        <div class="new-deck-cards" id="availableCardsContainer">
            <div class="no-cards">Please select a faction to load available cards.</div>
        </div>
    </div>

</div>

<script>
    const allCardsData = <?= json_encode($all_cards ?? []); ?>;
    
    let selectedFaction = '';
    let selectedLeader = null;
    let selectedDeckCards = []; 

    const factionBtns = document.querySelectorAll('[data-faction]');
    const searchInput = document.getElementById('cardSearchInput');
    const availableCardsContainer = document.getElementById('availableCardsContainer');
    const currentDeckContainer = document.getElementById('currentDeckContainer');
    const leaderSlotContainer = document.getElementById('leaderSlotContainer');
    
    const totalCardsCounter = document.getElementById('totalCardsCounter');
    const unitCardsCounter = document.getElementById('unitCardsCounter');
    const specialWeatherCounter = document.getElementById('specialWeatherCounter');

    factionBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            factionBtns.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            const newFaction = btn.getAttribute('data-faction').toLowerCase().trim();
            
            if (selectedFaction !== newFaction) {
                selectedFaction = newFaction;
                selectedLeader = null;
                selectedDeckCards = [];
                renderWorkspace();
            }

            renderAvailableCards();
        });
    });

    searchInput.addEventListener('input', () => {
        if (selectedFaction) renderAvailableCards();
    });

    function getFactionDisplayName(factionRaw) {
        const f = (factionRaw || '').toLowerCase().trim();
        if (f === 'realms') return 'Northern Realms';
        if (f === 'weather') return 'Weather Card';
        if (f === 'special') return 'Special Card';
        if (!f || f === 'neutral') return 'Neutral';
        return factionRaw.charAt(0).toUpperCase() + factionRaw.slice(1);
    }

    function createCardHTML(card, displayCount = null) {
        const rowNorm = (card.row || '').toLowerCase().trim();
        const factionDisplay = getFactionDisplayName(card.deck);
        const maxAllowed = card.count ?? 1;
        const badgeHTML = displayCount ? `<span class="card-amount">${displayCount} / ${maxAllowed}</span>` : ``;

        return `
            ${badgeHTML}
            <h3 class="card-title">${card.name}</h3>
            <div class="card-img-wrapper">
                ${card.filename ? `<img src="../obrazky/${card.deck}_${card.filename}.jpg" alt="${card.name}">` : `<div class="no-img">No Image</div>`}
            </div>
            <div class="card-stats">
                <div class="stat-row"><span>Faction:</span><strong>${factionDisplay}</strong></div>
                <div class="stat-row"><span>Row:</span><strong>${rowNorm ? rowNorm.charAt(0).toUpperCase() + rowNorm.slice(1) : 'None'}</strong></div>
                <div class="stat-row"><span>Strength:</span><strong class="gold-text">${card.strength ?? 0}</strong></div>
                <div class="stat-row" title="${card.ability || 'None'}"><span>Ability:</span><strong class="ability-text">${card.ability || 'None'}</strong></div>
            </div>
        `;
    }

    function getSpecialWeatherCount() {
        return selectedDeckCards.reduce((acc, c) => {
            const f = (c.deck || '').toLowerCase().trim();
            return (f === 'weather' || f === 'special') ? acc + c.selectedCount : acc;
        }, 0);
    }

    // VYKRESLENÍ NABÍDKY KARET (PRAVÁ STRANA)
    function renderAvailableCards() {
        availableCardsContainer.innerHTML = '';
        const query = searchInput.value.toLowerCase().trim();
        
        // Zjistíme, jestli už balíček nemá plno pro speciální/weather karty
        const globalSpecialWeatherLimitReached = getSpecialWeatherCount() >= 10;

        const filteredCards = allCardsData.filter(card => {
            const cardFaction = (card.deck || '').toLowerCase().trim();
            const isSpecWeath = (cardFaction === 'weather' || cardFaction === 'special');

            // 1. FILTR: Pokud padl globální limit 10 speciálních karet, přestaň je v nabídce úplně zobrazovat
            if (isSpecWeath && globalSpecialWeatherLimitReached) {
                return false;
            }

            // 2. FILTR: Pokud karta dosáhla svého interního limitu (count z DB) nebo už je vybraný tento Leader
            const rowNorm = (card.row || '').toLowerCase().trim();
            if (rowNorm === 'leader') {
                if (selectedLeader && selectedLeader.id === card.id) {
                    return false;
                }
            } else {
                const existing = selectedDeckCards.find(c => c.id === card.id);
                const maxAllowed = card.count ?? 1;
                if (existing && existing.selectedCount >= maxAllowed) {
                    return false; // Karta dosáhla limitu kopií -> zmizí z nabídky
                }
            }

            // Klasické filtrování podle frakcí a textu
            const isGlobal = cardFaction === 'neutral' || cardFaction === '' || isSpecWeath;
            const matchesFaction = cardFaction === selectedFaction || isGlobal;
            const matchesSearch = card.name.toLowerCase().includes(query) || (card.ability || '').toLowerCase().includes(query);
            return matchesFaction && matchesSearch;
        });

        if (filteredCards.length === 0) {
            availableCardsContainer.innerHTML = '<div class="no-cards">No cards match your criteria.</div>';
            return;
        }

        const cardsGrid = document.createElement('div');
        cardsGrid.className = 'cards-grid';

        filteredCards.forEach(card => {
            const rowNorm = (card.row || '').toLowerCase().trim();
            const cardItem = document.createElement('div');
            cardItem.className = 'card-item';
            cardItem.setAttribute('data-row', rowNorm);

            cardItem.innerHTML = createCardHTML(card);

            cardItem.addEventListener('click', () => {
                if (rowNorm === 'leader') {
                    selectedLeader = card;
                } else {
                    const cardFaction = (card.deck || '').toLowerCase().trim();
                    const isSpecWeath = (cardFaction === 'weather' || cardFaction === 'special');

                    if (isSpecWeath && getSpecialWeatherCount() >= 10) {
                        alert("Maximum limit of 10 Weather / Special cards reached!");
                        return; 
                    }

                    const existing = selectedDeckCards.find(c => c.id === card.id);
                    const maxAllowed = card.count ?? 1;

                    if (existing) {
                        if (existing.selectedCount >= maxAllowed) return;
                        existing.selectedCount++;
                    } else {
                        selectedDeckCards.push({ ...card, selectedCount: 1 });
                    }
                }
                
                // Překreslíme Workspace i Nabídku karet, aby plná karta hned zmizela
                renderWorkspace();
                renderAvailableCards(); 
            });

            cardsGrid.appendChild(cardItem);
        });

        availableCardsContainer.appendChild(cardsGrid);
    }

    // VYKRESLENÍ WORKSPACU (LEVÁ STRANA)
    function renderWorkspace() {
        leaderSlotContainer.innerHTML = '';
        if (selectedLeader) {
            const leaderCard = document.createElement('div');
            leaderCard.className = 'card-item leader-card-active';
            leaderCard.setAttribute('data-row', 'leader');
            leaderCard.innerHTML = createCardHTML(selectedLeader);
            leaderCard.addEventListener('click', () => {
                selectedLeader = null;
                renderWorkspace();
                renderAvailableCards(); // Leader byl odebrán -> vrátí se do nabídky vpravo
            });
            leaderSlotContainer.appendChild(leaderCard);
        } else {
            leaderSlotContainer.innerHTML = `<div class="leader-empty-box"><span>Select a Leader</span></div>`;
        }

        currentDeckContainer.innerHTML = '';
        let totalCount = 0;
        let unitCount = 0;
        let specWeathCount = 0;

        if (selectedDeckCards.length === 0) {
            currentDeckContainer.innerHTML = '<div class="no-cards">Your workspace is empty. Select a faction and click cards on the right.</div>';
            totalCardsCounter.textContent = '0';
            unitCardsCounter.textContent = '0 / 22 min';
            unitCardsCounter.style.color = '#e74c3c';
            specialWeatherCounter.textContent = '0 / 10 max';
            return;
        }

        selectedDeckCards.forEach(card => {
            totalCount += card.selectedCount;
            const cardFaction = (card.deck || '').toLowerCase().trim();
            
            if (cardFaction === 'weather' || cardFaction === 'special') {
                specWeathCount += card.selectedCount;
            } else {
                unitCount += card.selectedCount;
            }

            const rowNorm = (card.row || '').toLowerCase().trim();
            const cardItem = document.createElement('div');
            cardItem.className = 'card-item workspace-scaled-card';
            cardItem.setAttribute('data-row', rowNorm);
            
            cardItem.innerHTML = createCardHTML(card, card.selectedCount);

            cardItem.addEventListener('click', () => {
                card.selectedCount--;
                if (card.selectedCount <= 0) {
                    selectedDeckCards = selectedDeckCards.filter(c => c.id !== card.id);
                }
                
                // Překreslíme Workspace i Nabídku karet, aby se uvolněná karta zase objevila vpravo
                renderWorkspace();
                renderAvailableCards(); 
            });

            currentDeckContainer.appendChild(cardItem);
        });

        totalCardsCounter.textContent = totalCount;
        specialWeatherCounter.textContent = `${specWeathCount} / 10 max`;
        
        unitCardsCounter.textContent = `${unitCount} / 22 min`;
        if (unitCount >= 22) {
            unitCardsCounter.style.color = '#2ecc71';
        } else {
            unitCardsCounter.style.color = '#e74c3c';
        }
    }

    // Ukládání do databáze
    document.getElementById('saveDeckBtn').addEventListener('click', () => {
        const deckName = document.getElementById('deckNameInput').value.trim();
        const deckDesc = document.getElementById('deckDescInput').value.trim();

        if (!deckName) {
            alert("Please enter a Deck Name!");
            return;
        }
        if (!selectedFaction) {
            alert("Please select a faction first!");
            return;
        }
        if (!selectedLeader) {
            alert("Please select a Leader for your deck!");
            return;
        }

        const unitCount = selectedDeckCards.reduce((acc, c) => {
            const f = (c.deck || '').toLowerCase().trim();
            return (f !== 'weather' && f !== 'special') ? acc + c.selectedCount : acc;
        }, 0);

        if (unitCount < 22) {
            alert(`Your deck must contain at least 22 unit cards! (Currently you have ${unitCount})`);
            return;
        }

        const cardsPayload = selectedDeckCards.map(card => {
            return {
                name: card.name,
                count: card.selectedCount
            };
        });

        cardsPayload.push({
            name: selectedLeader.name,
            count: 1
        });

        const payload = {
            nazev: deckName,
            popis: deckDesc,
            karty: cardsPayload
        };

        const saveBtn = document.getElementById('saveDeckBtn');
        saveBtn.disabled = true;
        saveBtn.textContent = 'Saving...';

        // Použijeme pevnou URL místo window.location.href
        // (window.location.href může obsahovat hash nebo query string)
        fetch('/baliky/vytvor', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(payload)
        })
        .then(response => {
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            return response.json();
        })
        .then(data => {
            if (data.success) {
                alert('Deck successfully saved!');
                window.location.href = '/baliky'; 
            } else {
                alert('Error saving deck: ' + (data.message || 'Unknown error'));
                saveBtn.disabled = false;
                saveBtn.textContent = 'Save Deck to Database';
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Server connection failed! Check that you are logged in.');
            saveBtn.disabled = false;
            saveBtn.textContent = 'Save Deck to Database';
        });
    });
    
</script>